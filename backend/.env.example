# Server Port
PORT=5000

# OpenRouter AI Key (Optional, fallback drills & progress narration provided if omitted)
OPENROUTER_API_KEY=your-openrouter-api-key

# Supabase Persistence Configuration (Optional, falls back to SQLite & in-memory if omitted)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Prototype Default User UUID (Optional)
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000000
